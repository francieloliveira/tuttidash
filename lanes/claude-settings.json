{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "3600000",
    "BASH_MAX_TIMEOUT_MS": "3600000",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Grep(./**)",
      "Glob(./**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__transcentia-docs"
    ],
    "deny": [
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(/usr/bin/python3:*)",
      "Bash(cat:*)",
      "Bash(/bin/cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(/usr/bin/sort:*)",
      "Bash(security:*)",
      "Bash(/usr/bin/security:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git config:*)",
      "Bash(git difftool:*)",
      "Bash(git commit-tree:*)",
      "Bash(git diff --no-index:*)",
      "Bash(git commit -F:*)",
      "Bash(git commit --file:*)",
      "Bash(gh:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(./scripts/safe_xcodebuild.sh:*)",
      "Bash(scripts/safe_xcodebuild.sh:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(open:*)",
      "Bash(osascript:*)",
      "Bash(./scripts/hash_fonte_inpi.sh:*)",
      "Bash(scripts/hash_fonte_inpi.sh:*)",
      "WebFetch",
      "WebSearch",
      "Read(**/.ssh/**)",
      "Read(**/.config/gh/**)",
      "Read(**/.transcentia/**)",
      "Read(**/.grok/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Grep(**/.ssh/**)",
      "Grep(**/.config/gh/**)",
      "Grep(**/.transcentia/**)",
      "Grep(**/.grok/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.config/gh/**)",
      "Edit(**/.transcentia/**)",
      "Edit(**/.grok/**)",
      "Write(**/.ssh/**)",
      "Write(**/.config/gh/**)",
      "Write(**/.transcentia/**)",
      "Write(**/.grok/**)",
      "Edit(.git/config)",
      "Write(.git/config)",
      "Edit(.git/hooks/**)",
      "Write(.git/hooks/**)",
      "Edit(docs/produto/caminho.md)",
      "Write(docs/produto/caminho.md)",
      "Edit(docs/produto/pacote-inpi.md)",
      "Write(docs/produto/pacote-inpi.md)",
      "Edit(docs/produto/inpi-hash-manifest.txt)",
      "Write(docs/produto/inpi-hash-manifest.txt)",
      "Edit(docs/produto/mvp-patente.md)",
      "Write(docs/produto/mvp-patente.md)",
      "Edit(scripts/hash_fonte_inpi.sh)",
      "Write(scripts/hash_fonte_inpi.sh)",
      "Edit(docs/arquivo/**)",
      "Write(docs/arquivo/**)",
      "Edit(scripts/lanes/**)",
      "Write(scripts/lanes/**)",
      "Edit(scripts/safe_xcodebuild.sh)",
      "Write(scripts/safe_xcodebuild.sh)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "network": {
      "allowedDomains": [],
      "deniedDomains": ["*"],
      "strictAllowlist": true,
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.transcentia",
        "~/.grok",
        "~/.aws",
        "~/.gnupg",
        "/usr/bin/security"
      ],
      "denyWrite": [
        ".git/config",
        ".git/hooks"
      ]
    }
  }
}
