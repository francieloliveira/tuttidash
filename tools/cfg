_LIB = None


def _lib():
    """gasto_lanes/config.py, pelo caminho: o cfg instalado não é um pacote."""
    global _LIB
    if _LIB is not None:
        return _LIB
    import importlib.util
    aqui = Path(__file__).resolve().parent
    # Ao lado (cópia instalada), no checkout (tools/../gasto_lanes) e no cwd
    # (teste que copia só o cfg para um HOME falso e roda a partir do repo).
    candidatos = (
        aqui / "config.py",
        aqui.parent / "gasto_lanes" / "config.py",
        Path.cwd() / "gasto_lanes" / "config.py",
    )
    for candidato in candidatos:
        if not candidato.is_file():
            continue
        nome = "tuttidash_gasto_config"
        spec = importlib.util.spec_from_file_location(nome, candidato)
        if spec is None or spec.loader is None:
            continue
        mod = importlib.util.module_from_spec(spec)
        sys.modules[nome] = mod
        spec.loader.exec_module(mod)
        if hasattr(mod, "arquivo_config"):
            _LIB = mod
            return mod
    raise ImportError("gasto_lanes/config.py")


def arquivo():
    return _lib().arquivo_config()


def carregar():
    p = arquivo()
    if p is None:
        return {}
    try:
        d = json.loads(p.read_text())
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


_MISS = object()


def _busca(d, chave):
    for parte in chave.split("."):
        if isinstance(d, dict) and parte in d:
            d = d[parte]
        else:
            return _MISS
    return d


def get(chave, padrao=None):
    v = _busca(carregar(), chave)
    if v is _MISS or v is None or v == "":
        v = _busca(DEFAULTS, chave) if padrao is None else padrao
        return None if v is _MISS else v
    return v


def _fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (dict, list)):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


def _mesclar(base, extra):
    """Delegação ao resolvedor: não mistura tipos e não leva jobs sem validação."""
    return _lib().mesclar(base, extra)


def _gravar(path: Path, dados) -> None:
    """Grava o JSON e deixa o arquivo só para o dono (0600)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(dados, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(path)
    os.chmod(path, 0o600)


def _faltantes(base, atual):
    """Acrescenta em `atual` só as chaves de `base` que faltam (nunca muda valor existente)."""
    out = dict(atual)
    for k, v in base.items():
        if k not in out:
            out[k] = v
        elif isinstance(v, dict) and isinstance(out[k], dict):
            out[k] = _faltantes(v, out[k])
    return out


def _copiar_pasta_lanekeeper():
    """FRA-523: copia (não move) os arquivos da pasta Lanekeeper para a TuttiDash.
    Não sobrescreve nada que já exista na pasta nova."""
    antiga, nova = _lanekeeper().parent, _novo().parent
    if not antiga.is_dir():
        return
    import shutil
    nova.mkdir(parents=True, exist_ok=True)
    for f in antiga.iterdir():
        alvo = nova / f.name
        if f.is_file() and not alvo.exists():
            shutil.copy2(f, alvo)
            print(f"copiado: {f} -> {alvo}")


NOMES_ANTIGOS = {"TranscentIA Lanes (dispatcher)": "TuttiDash Dispatcher",
                 "TranscentIA Bots (vigia)": "TuttiDash Vigia", "TranscentIA Chave Bots": "TuttiDash Chave"}


def _renomear_jobs(d):
    """FRA-523: troca os nomes antigos dos lançadores (Itens de Login) pelos do TuttiDash."""
    for j in (d.get("agendas", {}) or {}).get("jobs", []) or []:
        if isinstance(j, dict) and j.get("nome") in NOMES_ANTIGOS:
            j["nome"] = NOMES_ANTIGOS[j["nome"]]
    return d


def _ler_json(path: Path):
    try:
        dados = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return dados if isinstance(dados, dict) else None


def migrar():
    novo = _novo()
    ja_tinha = novo.exists()
    _copiar_pasta_lanekeeper()
    if ja_tinha:
        try:
            atual = json.loads(novo.read_text(encoding="utf-8"))
        except Exception:
            print(f"já existe (ilegível, não mexo): {novo}")
            return 0
        completo = _renomear_jobs(_faltantes(DEFAULTS, json.loads(json.dumps(atual)))) if isinstance(atual, dict) else atual
        if completo != atual:
            _gravar(novo, completo)
            print(f"completado com padrões novos: {novo}")
        else:
            print(f"já existe: {novo}")
        return 0
    bruto = {}
    if novo.exists():
        # A cópia da pasta Lanekeeper acabou de criar o arquivo: é a origem.
        lido = _ler_json(novo)
        if lido is None:
            print(f"config copiada ilegível, usando só padrões: {novo}", file=sys.stderr)
        else:
            bruto = lido
    else:
        origem = next((p for p in (_lanekeeper(), _intermedio()) if p.exists()), _legado())
        if origem.exists():
            lido = _ler_json(origem)
            if lido is None:
                print(f"config antiga ilegível, usando só padrões: {origem}", file=sys.stderr)
            else:
                bruto = lido
    d = _renomear_jobs(_mesclar(DEFAULTS, bruto))
    d["version"] = VERSION
    _gravar(novo, d)
    print(f"criado: {novo}")
    return 0


def main(argv):
    if len(argv) >= 2 and argv[0] == "get":
        padrao = argv[2] if len(argv) > 2 else None
        v = get(argv[1], padrao)
        print("" if v is None else _fmt(v))
        return 0
    if argv[:1] == ["path"]:
        p = arquivo(); print(p or ""); return 0
    if argv[:1] == ["migrate"]:
        return migrar()
    if argv[:1] == ["defaults"]:
        print(json.dumps(DEFAULTS, ensure_ascii=False, indent=2)); return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
