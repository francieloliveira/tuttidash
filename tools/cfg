def arquivo():
    e = os.environ.get("TRANSCENTIA_GASTO_CONFIG")
    if e:
        return Path(os.path.expanduser(e))
    for p in (NOVO, LANEKEEPER, INTERMEDIO, LEGADO):
        if p.exists():
            return p
    return None


def carregar():
    p = arquivo()
    if p is None:
        return {}
    try:
        d = json.loads(p.read_text())
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


_MISS = object()


def _busca(d, chave):
    for parte in chave.split("."):
        if isinstance(d, dict) and parte in d:
            d = d[parte]
        else:
            return _MISS
    return d


def get(chave, padrao=None):
    v = _busca(carregar(), chave)
    if v is _MISS or v is None or v == "":
        v = _busca(DEFAULTS, chave) if padrao is None else padrao
        return None if v is _MISS else v
    return v


def _fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (dict, list)):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


def _mesclar(base, extra):
    out = dict(base)
    for k, v in extra.items():
        out[k] = _mesclar(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def _faltantes(base, atual):
    """Acrescenta em `atual` só as chaves de `base` que faltam (nunca muda valor existente)."""
    out = dict(atual)
    for k, v in base.items():
        if k not in out:
            out[k] = v
        elif isinstance(v, dict) and isinstance(out[k], dict):
            out[k] = _faltantes(v, out[k])
    return out


def _copiar_pasta_lanekeeper():
    """FRA-523: copia (não move) os arquivos da pasta Lanekeeper para a TuttiDash.
    Não sobrescreve nada que já exista na pasta nova."""
    antiga, nova = LANEKEEPER.parent, NOVO.parent
    if not antiga.is_dir():
        return
    import shutil
    nova.mkdir(parents=True, exist_ok=True)
    for f in antiga.iterdir():
        alvo = nova / f.name
        if f.is_file() and not alvo.exists():
            shutil.copy2(f, alvo)
            print(f"copiado: {f} -> {alvo}")


NOMES_ANTIGOS = {"TranscentIA Lanes (dispatcher)": "TuttiDash Dispatcher",
                 "TranscentIA Bots (vigia)": "TuttiDash Vigia", "TranscentIA Chave Bots": "TuttiDash Chave"}


def _renomear_jobs(d):
    """FRA-523: troca os nomes antigos dos lançadores (Itens de Login) pelos do TuttiDash."""
    for j in (d.get("agendas", {}) or {}).get("jobs", []) or []:
        if isinstance(j, dict) and j.get("nome") in NOMES_ANTIGOS:
            j["nome"] = NOMES_ANTIGOS[j["nome"]]
    return d


def migrar():
    _copiar_pasta_lanekeeper()
    if NOVO.exists():
        try:
            atual = json.loads(NOVO.read_text())
        except Exception:
            print(f"já existe (ilegível, não mexo): {NOVO}")
            return 0
        novo = _renomear_jobs(_faltantes(DEFAULTS, json.loads(json.dumps(atual)))) if isinstance(atual, dict) else atual
        if novo != atual:
            tmp = NOVO.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(novo, ensure_ascii=False, indent=2) + "\n")
            tmp.replace(NOVO)
            print(f"completado com padrões novos: {NOVO}")
        else:
            print(f"já existe: {NOVO}")
        return 0
    legado = {}
    origem = next((p for p in (LANEKEEPER, INTERMEDIO) if p.exists()), LEGADO)
    if origem.exists():
        try:
            legado = json.loads(origem.read_text())
        except Exception:
            print(f"config antiga ilegível, usando só padrões: {origem}", file=sys.stderr)
    d = _mesclar(DEFAULTS, legado if isinstance(legado, dict) else {})
    d["version"] = VERSION
    _renomear_jobs(d)
    NOVO.parent.mkdir(parents=True, exist_ok=True)
    tmp = NOVO.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n")
    tmp.replace(NOVO)
    print(f"criado: {NOVO}")
    return 0


def main(argv):
    if len(argv) >= 2 and argv[0] == "get":
        padrao = argv[2] if len(argv) > 2 else None
        v = get(argv[1], padrao)
        print("" if v is None else _fmt(v))
        return 0
    if argv[:1] == ["path"]:
        p = arquivo(); print(p or ""); return 0
    if argv[:1] == ["migrate"]:
        return migrar()
    if argv[:1] == ["defaults"]:
        print(json.dumps(DEFAULTS, ensure_ascii=False, indent=2)); return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
